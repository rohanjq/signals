{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ytstack:signals:schema:websocket:v1",
  "title": "Signals V1 WebSocket Message",
  "oneOf": [
    {"$ref": "#/$defs/subscribe"},
    {"$ref": "#/$defs/subscribed"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/eventBatch"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "seriesSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "timeframe"],
      "properties": {
        "dataset": {"type": "string"},
        "symbol": {"type": "string", "minLength": 1},
        "timeframe": {"type": "string", "pattern": "^[1-9][0-9]*[smhdw]$"}
      }
    },
    "analysisSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "config_hash": {"type": "string", "minLength": 1}
      }
    },
    "subscribe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "request_id", "data"],
      "properties": {
        "protocol": {"const": "signals.v1"},
        "type": {"const": "subscribe"},
        "request_id": {"type": "string", "minLength": 1},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["series"],
          "properties": {
            "series": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/seriesSelector"}},
            "analyses": {"type": "array", "items": {"$ref": "#/$defs/analysisSelector"}},
            "event_types": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "statuses": {"type": "array", "items": {"enum": ["confirmed", "provisional"]}, "uniqueItems": true},
            "resume_after": {"type": "string", "pattern": "^[0-9]+$"},
            "history": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"limit": {"type": "integer", "minimum": 0, "maximum": 1000}}
            }
          }
        }
      }
    },
    "subscribed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "request_id", "subscription_id", "data"],
      "properties": {
        "protocol": {"const": "signals.v1"},
        "type": {"const": "subscribed"},
        "request_id": {"type": "string", "minLength": 1},
        "subscription_id": {"type": "string", "minLength": 1},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["server_time", "heartbeat_seconds", "delivery"],
          "properties": {
            "server_time": {"type": "string", "format": "date-time"},
            "heartbeat_seconds": {"type": "integer", "minimum": 1},
            "delivery": {"const": "at_least_once"}
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "subscription_id", "data"],
      "properties": {
        "protocol": {"const": "signals.v1"},
        "type": {"const": "event"},
        "subscription_id": {"type": "string", "minLength": 1},
        "cursor": {"type": "string", "pattern": "^[0-9]+$"},
        "data": {"$ref": "urn:ytstack:signals:schema:analysis:v1"}
      }
    },
    "eventBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "subscription_id", "data"],
      "properties": {
        "protocol": {"const": "signals.v1"},
        "type": {"enum": ["snapshot", "history"]},
        "subscription_id": {"type": "string", "minLength": 1},
        "data": {"type": "array", "items": {"$ref": "urn:ytstack:signals:schema:analysis:v1"}}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "error"],
      "properties": {
        "protocol": {"const": "signals.v1"},
        "type": {"const": "error"},
        "request_id": {"type": "string"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "retryable": {"type": "boolean"},
            "details": {"type": "object", "additionalProperties": true}
          }
        }
      }
    }
  }
}