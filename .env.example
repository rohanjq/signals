# Required API credential. Generate one with: openssl rand -hex 32
SIGNALD_API_TOKEN=replace-with-a-long-random-token

# Existing OHLC WebSocket. The Compose default reaches an OHLC daemon on the host.
SIGNALD_OHLC_WS_URL=ws://host.docker.internal:8080/ws
SIGNALD_OHLC_TOKEN=

SIGNALD_DATASET=live
SIGNALD_SERIES=BTCUSDT:1m,BTCUSDT:5m,BTCUSDT:15m,BTCUSDT:1h
SIGNALD_EMA_PERIODS=9,21,50,200
SIGNALD_SEED_BARS=500
SIGNALD_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8082,http://localhost:8082,http://127.0.0.1:18110,http://localhost:18110

# Local Compose database settings. Use managed PostgreSQL with TLS in production.
SIGNALD_POSTGRES_DB=signald
SIGNALD_POSTGRES_USER=signald
SIGNALD_POSTGRES_PASSWORD=replace-with-a-long-random-password
SIGNALD_POSTGRES_PORT=5433

SIGNALD_DATABASE_MAX_CONNS=10
SIGNALD_MAILBOX_SIZE=1024
SIGNALD_SNAPSHOT_EVERY=100
SIGNALD_OUTBOX_POLL_INTERVAL=250ms
SIGNALD_SHUTDOWN_TIMEOUT=15s
SIGNALD_LOG_LEVEL=info

# Use three replicas against a three-node JetStream cluster in production.
NATS_AUTH_TOKEN=replace-with-at-least-32-random-characters
NATS_REPLICAS=1
